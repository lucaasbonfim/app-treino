PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# URL do frontend publicado no Render (liberada no CORS além das origens locais/Capacitor).
# Ex.: https://korvix-gym.onrender.com
FRONTEND_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_treino
DB_SCHEMA=public
DB_SSL=false

JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Login com Google. Precisa ser o MESMO Client ID (tipo "Aplicativo Web") usado
# no VITE_GOOGLE_CLIENT_ID do frontend — o backend recusa tokens de outro app.
# Vazio = rota /auth/google responde 503 e o botão some da tela de login.
GOOGLE_CLIENT_ID=

# URL do frontend usada no botão do e-mail
APP_URL=http://localhost:5173/#/register
EMAIL_VERIFICATION_EXPIRY_MINUTES=15

# E-mail: Brevo HTTP API (prioritário)
BREVO_API_KEY=

# E-mail: SMTP (fallback quando BREVO_API_KEY estiver vazio ou falhar)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KorVix Gym <no-reply@seudominio.com>"

# Leitura de ficha por IA (texto ou foto). Sem a chave, o app esconde o botão
# "Montar com IA". Pegue a sua em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcionais: modelo e quanto o modelo "pensa" (minimal | low | medium | high).
# Flash Lite dá 500 requisições/dia no plano gratuito; o Flash normal dá só 20.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
